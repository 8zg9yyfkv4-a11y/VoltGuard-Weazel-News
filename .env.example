# ============ DISCORD BOT ============
# Da https://discord.com/developers/applications -> la tua app -> Bot -> Reset Token
DISCORD_TOKEN=incolla_qui_il_token_del_bot

# Da https://discord.com/developers/applications -> la tua app -> General Information
DISCORD_CLIENT_ID=incolla_qui_il_client_id

# Da General Information -> Client Secret (serve solo per il pannello admin, OAuth2 login)
DISCORD_CLIENT_SECRET=incolla_qui_il_client_secret

# ============ PANNELLO ADMIN ============
# URL su cui gira il pannello (deve combaciare con il Redirect URI configurato su Discord)
ADMIN_BASE_URL=http://localhost:3000
ADMIN_PORT=3000

# Stringa lunga e casuale, usata per firmare le sessioni. Generane una nuova, non usare questa.
SESSION_SECRET=cambia_questa_stringa_con_qualcosa_di_lungo_e_casuale

# ============ FACOLTATIVO ============
# Se impostato, l'auto-moderazione userà anche l'API di OpenAI (moderation endpoint)
# per rilevare tossicità/contenuti pericolosi oltre al filtro parole. Lascia vuoto per usare solo il filtro locale.
OPENAI_API_KEY=
